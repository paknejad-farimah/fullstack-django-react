# Copy this file to .env on the server and replace every placeholder.
SECRET_KEY=replace-with-a-new-long-random-secret
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com
BACKEND_DOMAIN=https://yourusername.pythonanywhere.com
FRONTEND_DOMAIN=https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app
CSRF_TRUSTED_ORIGINS=https://your-site.netlify.app

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-new-gmail-app-password

ZIBAL_MERCHANT=your-merchant-id
